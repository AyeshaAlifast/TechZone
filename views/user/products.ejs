<%- include('../partials/header') %>

<div class="products">
  <h1 class="page-title">Our Products</h1>

  <form method="GET" action="/products" class="search-form">

    <input type="text" name="search" placeholder="Search products..." value="<%= search || '' %>">

    <select name="category">
      <option value="">All Categories</option>

      <option value="Phones" <%= category === 'Phones' ? 'selected' : '' %>>Phones</option>
      <option value="Laptops" <%= category === 'Laptops' ? 'selected' : '' %>>Laptops</option>
      <option value="Tablets" <%= category === 'Tablets' ? 'selected' : '' %>>Tablets</option>
      <option value="Accessories" <%= category === 'Accessories' ? 'selected' : '' %>>Accessories</option>
      <option value="TVs" <%= category === 'TVs' ? 'selected' : '' %>>TVs</option>
    </select>

    <button type="submit" class="btn">Search</button>
  </form>

  <% if (products.length > 0) { %>

  <div class="product-grid">
    <% products.forEach(product => { %>
      <div class="product-card">
        <img src="<%= product.image || '/images/placeholder.jpg' %>" alt="<%= product.name %>">
        <h3><%= product.name %></h3>
        <p><%= product.price %></p>
        <p>Stock: <%= product.stock %></p>
        <a href="/products/<%= product._id %>" class="btn">View Details</a>
      </div>
    <% }) %>
  </div>

  <% } else { %>
    <p class="no-products">No products found for your search.</p>
  <% } %>

</div>

<%- include('../partials/footer') %>