<%- include('../partials/header') %>

<div class="home">
  <img src="/home.jpg" alt="TechZone Banner">

  <div class="home-content">
    <h1 class="">Welcome to TechZone</h1>
    <p>Your one-stop shop for the latest tech gadgets at unbeatable prices</p>
    <a href="/products" class="btn">Shop Now</a>
  </div>
</div>

<% if (products.length > 0) { %>
<div class="featured-products">
  <h2 class="section-title">Featured Products</h2>

  <div class="product-grid">
    <% products.forEach(product => { %>
      <div class="product-card">
        <img src="<%= product.image || '/images/placeholder.jpg' %>" alt="<%= product.name %>">

        <h3><%= product.name %></h3>
        <p><%= product.price %></p>

        <a href="/products/<%= product._id %>" class="btn">View Details</a>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<section class="why-us">
  <h2 class="section-title">Why Choose TechZone?</h2>

  <div class="features">
    <div class="feature-card">
      <h3>⚡ Fast Delivery</h3>
      <p>All over Pakistan delivery in minimum time.</p>
    </div>

    <div class="feature-card">
      <h3>🔒 Secure Payment</h3>
      <p>COD, Easypaisa & bank transfer supported.</p>
    </div>

    <div class="feature-card">
      <h3>✔ Original Products</h3>
      <p>100% verified and authentic gadgets only.</p>
    </div>
  </div>
</section>

<section class="stats">
  <div class="stat-card">
    <h3>10K+</h3>
    <p>Happy Customers</p>
  </div>

  <div class="stat-card">
    <h3>500+</h3>
    <p>Products Available</p>
  </div>

  <div class="stat-card">
    <h3>24/7</h3>
    <p>Customer Support</p>
  </div>
</section>

<%- include('../partials/footer') %>