<%- include('../partials/header') %>

<div class="contact-container">

  <!-- Hero -->
  <section class="contact-hero">
    <h1>Contact Us</h1>
    <p>We’re here to help you 24/7. Reach out anytime!</p>
  </section>

  <!-- Content Wrapper -->
  <div class="contact-wrapper">

    <!-- Contact Info -->
    <div class="contact-info">
      <h2>Get in Touch</h2>
      <p>Have questions about TechZone products or orders? Our support team is ready to help.</p>

      <div class="info-box">
        <p>📍 Islamabad, Pakistan</p>
        <p>📧 support@techzone.com</p>
        <p>📞 +92 300 1234567</p>
      </div>

      <div class="info-box">
        <p>⏰ Mon - Sat: 9AM - 9PM</p>
        <p>⚡ Fast Response Time</p>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="contact-form">

      <% if (error && error.length > 0) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <% if (success && success.length > 0) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <form method="POST" action="/contact">

        <div class="form-group">
          <label>Name</label>
          <input type="text" name="name" placeholder="Your name" required>
        </div>

        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="Your email" required>
        </div>

        <div class="form-group">
          <label>Message</label>
          <textarea name="message" rows="6" placeholder="Write your message..." required></textarea>
        </div>

        <button type="submit" class="btn-send">Send Message</button>

      </form>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>