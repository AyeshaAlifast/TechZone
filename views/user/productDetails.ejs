<%- include('../partials/header') %>

<div class="product-details">

  <% if (product) { %>

    <div class="product-card-detail">

      <!-- IMAGE SECTION -->
      <div class="product-image-box">
        <img src="<%= product.image || '/images/placeholder.jpg' %>" alt="<%= product.name %>">
      </div>

      <!-- INFO SECTION -->
      <div class="product-info-box">

        <h1 class="product-title"><%= product.name %></h1>

        <p class="product-desc"><%= product.description %></p>

        <div class="product-meta">
          <div><span>Price:</span> <strong>$<%= product.price %></strong></div>
          <div><span>Stock:</span> <strong><%= product.stock %></strong></div>
          <div><span>Category:</span> <strong><%= product.category %></strong></div>
        </div>

        <form method="POST" action="/cart/add" class="cart-form">
          <input type="hidden" name="productId" value="<%= product._id %>">

          <div class="qty-box">
            <label>Quantity</label>
            <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>">
          </div>

          <button type="submit" class="btn add-cart-btn">
            Add to Cart
          </button>
        </form>

      </div>

    </div>

  <% } else { %>

    <div class="not-found">
      <h2>Product not found</h2>
      <a href="/products" class="btn">Go Back</a>
    </div>

  <% } %>

</div>

<%- include('../partials/footer') %>