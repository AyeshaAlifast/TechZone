<%- include('../partials/header') %>

<div class="dashboard">
  <h1>Welcome, <%= name %> 👋</h1>

  <div class="dashboard-grid">
    <div class="dashboard-col">
      <div class="stat-card">
        <h3>Total Users</h3>
        <p><%= totalUsers %></p>
      </div>
      <a href="/admin/users" class="btn">Manage Users</a>
    </div>
    <div class="dashboard-col">
      <div class="stat-card">
        <h3>Total Products</h3>
        <p><%= totalProducts %></p>
      </div>
      <a href="/admin/products" class="btn">Manage Products</a>
    </div>
    <div class="dashboard-col">
      <div class="stat-card">
        <h3>Total Orders</h3>
        <p><%= totalOrders %></p>
      </div>
      <a href="/admin/orders" class="btn">View Orders</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
